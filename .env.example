# Synctona — переменные окружения (префикс SYNCTONA_, вложенность через "__")
# В docker-compose значения уже заданы; этот файл нужен для локального запуска агента.

# LiveKit (dev-значения LiveKit-сервера в режиме --dev)
SYNCTONA_LIVEKIT__URL=ws://localhost:7880
SYNCTONA_LIVEKIT__API_KEY=devkey
SYNCTONA_LIVEKIT__API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Эндпоинты сервисов моделей
SYNCTONA_ASR_ENDPOINT=http://localhost:8003
SYNCTONA_NMT__ENDPOINT=http://localhost:8002
SYNCTONA_TTS_POOL__ENDPOINT=http://localhost:8001

# Redis (реестр голосов спикеров)
SYNCTONA_REDIS_URL=redis://localhost:6379/0

# Наблюдаемость
SYNCTONA_METRICS_PORT=9100
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Устройства для сервисов моделей: cpu | cuda
SYNCTONA_ASR_DEVICE=cpu
SYNCTONA_ASR_MODEL=small
SYNCTONA_NMT_DEVICE=cpu
SYNCTONA_TTS_DEVICE=cpu
